root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# TLA+ models. Indentation is SEMANTICALLY SIGNIFICANT in TLA+: an aligned
# conjunction or disjunction list (/\ or \/ at a fixed column) is a single
# expression whose extent is defined by that column, so re-indenting a model
# changes what it means — or stops it parsing. Leave it to the author.
#
# Same reasoning, and the same remedy, as the `[*.rs] indent_size = unset`
# entry in the workspace-root .editorconfig.
[*.tla]
indent_size = unset
indent_style = unset

# herdtools litmus tests. The instruction blocks are column-aligned per thread
# and herd7 parses that layout.
[*.litmus]
indent_size = unset
indent_style = unset

# Nim. Doc comments carry hand-aligned tables and transcribed C ABI
# declarations whose continuation lines align under an opening paren, so they
# land on odd columns by design. Let nimpretty and project convention own the
# column math. This mirrors the workspace-root .editorconfig, whose rule this
# file's `root = true` would otherwise cut off.
[*.nim]
indent_size = unset

# Markdown. Indentation is structural here -- it decides list nesting and what
# is a code block -- and continuation lines under a bullet idiomatically land on
# odd columns. editorconfig-checker's multiple-of-two rule does not model that,
# and prettier already owns markdown formatting in this repo (see the pre-commit
# config), so let it. The verification tier's README additionally has tables
# aligned by hand so state counts read straight in a terminal, which is why
# .prettierignore exempts that one file from prettier as well.
[*.md]
indent_size = unset
indent_style = unset
