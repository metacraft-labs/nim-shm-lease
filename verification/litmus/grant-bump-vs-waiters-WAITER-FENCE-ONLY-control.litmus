C grant-bump-vs-waiters-WAITER-FENCE-ONLY-control
(*
 * A CONTROL, and it is what makes the SHIPPED asymmetry an argued choice rather
 * than a lucky one.
 *
 * `src/shm_lease/obsring.nim` fences BOTH sides of its Dekker pair, so the
 * obvious question when applying the same pattern in `waitword.nim` is whether
 * the waiter needs a fence too. This test answers the half that a "Never" verdict
 * cannot: it puts the fence on the WAITER ONLY and leaves the publisher as it was
 * BEFORE the fix.
 *
 *   P0, publisher, UNFENCED (the defective form):
 *       release store of `value`; seq-cst load of `waiters`
 *   P1, waiter, WITH a seq-cst fence it does not have in the shipped code:
 *       seq-cst RMW on `waiters`; fence; seq-cst load of `value`
 *
 * RESULT (herd7 7.58, 2026-08-18): **ALLOWED / "Sometimes 1 3"** — the lost
 * wakeup survives. Fencing the waiter fixes NOTHING, because the reordering that
 * loses the wakeup is the publisher's.
 *
 * Read together with `grant-bump-vs-waiters-FENCED-fix.litmus` (publisher fenced,
 * waiter bare: FORBIDDEN) this pins the asymmetry in both directions, and it is
 * the reason `waitOn`'s docstring says a waiter-side fence would buy nothing. An
 * unjustified barrier is not free of consequence: it is the next reader's
 * invitation to delete the justified one alongside it.
 *)
{
  value = 0;
  waiters = 0;
}

P0 (atomic_int *value, atomic_int *waiters) {
  atomic_store_explicit(value, 1, memory_order_release);
  int r0 = atomic_load_explicit(waiters, memory_order_seq_cst);
}

P1 (atomic_int *value, atomic_int *waiters) {
  atomic_fetch_add_explicit(waiters, 1, memory_order_seq_cst);
  atomic_thread_fence(memory_order_seq_cst);
  int r1 = atomic_load_explicit(value, memory_order_seq_cst);
}

exists (0:r0 = 0 /\ 1:r1 = 0)
