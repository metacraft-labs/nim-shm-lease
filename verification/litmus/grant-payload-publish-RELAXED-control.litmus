C grant-payload-publish-RELAXED-control
(*
 * THE CONTROL FOR `grant-payload-publish.litmus`, and the reason that test means
 * anything: identical shape with the release/acquire pair DOWNGRADED TO RELAXED.
 *
 * EXPECTED AND OBSERVED: **ALLOWED / "Sometimes 1 3"** (herd7 7.58, 2026-08-17).
 * If this were Forbidden too, the model would not be distinguishing the orders
 * and the shipped test's "Never" would have been free -- which is exactly how an
 * ordering suite gives false confidence.
 *)
{
  value = 0;
  payload = 0;
}

P0 (atomic_int *value, atomic_int *payload) {
  atomic_store_explicit(payload, 42, memory_order_relaxed);
  atomic_store_explicit(value, 1, memory_order_relaxed);
}

P1 (atomic_int *value, atomic_int *payload) {
  int r0 = atomic_load_explicit(value, memory_order_relaxed);
  int r1 = atomic_load_explicit(payload, memory_order_relaxed);
}

exists (1:r0 = 1 /\ 1:r1 = 0)
