# Nim build artifacts
nimcache/
# Per-checkout nimcache (config.nims): every Nim compile in this checkout
# keeps its intermediate files here, never in the shared ~/.cache/nim.
.nimcache/
*.exe
build/
test-logs/

# Generated by git-hooks.nix (Nix-managed; not committed by hand).
.pre-commit-config.yaml

# Compiled test / benchmark binaries (built next to their .nim sources).
tests/test_shm_lease
tests/test_shm_lease_hooks
tests/test_shm_lease_multiprocess
tests/test_shm_lease_waitword
tests/test_shm_lease_wait_multiprocess
tests/test_shm_lease_obsring
tests/test_shm_lease_obs_multiprocess
tests/test_shm_lease_arbiter
tests/test_shm_lease_arbiter_multiprocess
tests/test_shm_lease_starvation
tests/test_shm_lease_reclaim
tests/test_shm_lease_kill_injection
tests/test_nimcache_is_worktree_local
benchmarks/bench_claim
benchmarks/bench_wait
benchmarks/bench_obsring
benchmarks/probe_fastpath

# MV1 verification tier: the local opam root `verification/litmus/get-herd7.sh`
# builds herdtools7 into when nixpkgs has no package for it, and TLC's scratch
# state directories.
verification/litmus/herd7-opam/
verification/tla/states/
